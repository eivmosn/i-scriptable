{
  "name": "i-scriptable",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsdown && node dist/copy-assets.js",
    "dev": "pnpm build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve": "tsdown && node dist/copy-assets.js && node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ansis": "^4.3.0",
    "figlet": "^1.11.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/figlet": "^1.7.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
